#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SLUG="core-blueprint-profiles"
ENTRY="$ROOT/core-blueprint-profiles.php"
DIST="$ROOT/dist"
STAGE="$(mktemp -d)"
LOCALES=(nl_NL de_DE fr_FR es_ES it_IT pt_PT)
trap 'rm -rf "$STAGE"' EXIT

fail() {
  printf 'Profiles release build failed: %s\n' "$*" >&2
  exit 1
}

header_value() {
  local file="$1" label="$2"
  sed -n "s/^[[:space:]]*\\*[[:space:]]*${label}:[[:space:]]*//p" "$file" | head -n 1 | tr -d '\r'
}

define_value() {
  local file="$1" name="$2"
  sed -n "s/.*define([[:space:]]*['\"]${name}['\"][[:space:]]*,[[:space:]]*['\"]\\([^'\"]*\\)['\"].*/\\1/p" "$file" | head -n 1
}

[[ -f "$ENTRY" ]] || fail "plugin entrypoint is missing"
VERSION="$(header_value "$ENTRY" 'Version')"
REQUIRES_PHP="$(header_value "$ENTRY" 'Requires PHP')"
REQUIRES_PLUGINS="$(header_value "$ENTRY" 'Requires Plugins')"
CONSTANT_VERSION="$(define_value "$ENTRY" 'CB_PROFILES_VERSION')"
REQUIRED_API="$(define_value "$ENTRY" 'CB_PROFILES_REQUIRED_API')"
[[ -n "$VERSION" ]] || fail "plugin Version header is missing"
[[ "$VERSION" == '1.0.0-rc1' ]] || fail "unexpected launch version: $VERSION"
[[ "$CONSTANT_VERSION" == "$VERSION" ]] || fail "Version header and CB_PROFILES_VERSION differ"
[[ "$REQUIRES_PHP" == '8.4' ]] || fail "Requires PHP must be 8.4, found ${REQUIRES_PHP:-missing}"
[[ "$REQUIRES_PLUGINS" == 'core-blueprint' ]] || fail "Requires Plugins must be exactly core-blueprint"
[[ "$REQUIRED_API" == '1.0' ]] || fail "CB_PROFILES_REQUIRED_API must be 1.0, found ${REQUIRED_API:-missing}"

for command in php python3 wp msgfmt node zip unzip sha256sum find sort touch; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"
done
php -r 'exit(version_compare(PHP_VERSION, "8.4", ">=") ? 0 : 1);' || fail "PHP 8.4 or newer is required"

"$ROOT/tools/i18n/check"

while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null || fail "PHP lint failed: $file"
done < <(find "$ROOT" -type f -name '*.php' -not -path '*/.git/*' -not -path '*/dist/*' -not -path '*/build/*' -print0)

if [[ -d "$ROOT/assets" ]]; then
  while IFS= read -r -d '' file; do
    node --check "$file" >/dev/null || fail "JavaScript syntax failed: $file"
  done < <(find "$ROOT/assets" -type f -name '*.js' -print0)
fi

php "$ROOT/tools/conformance.php"

PACKAGE_ROOT="$STAGE/$SLUG"
ZIP="$DIST/$SLUG-$VERSION.zip"
CHECKSUM="$ZIP.sha256"
mkdir -p "$DIST" "$PACKAGE_ROOT"
rm -f "$ZIP" "$CHECKSUM"

for path in core-blueprint-profiles.php README.md CHANGELOG.md uninstall.php; do
  [[ -f "$ROOT/$path" ]] || fail "required release file is missing: $path"
  cp "$ROOT/$path" "$PACKAGE_ROOT/"
done
for path in src assets; do
  [[ -d "$ROOT/$path" ]] || fail "required release directory is missing: $path"
  cp -R "$ROOT/$path" "$PACKAGE_ROOT/"
done
mkdir -p "$PACKAGE_ROOT/languages"
cp "$ROOT/languages/core-blueprint-profiles.pot" "$PACKAGE_ROOT/languages/"

for locale in "${LOCALES[@]}"; do
  source_po="$ROOT/languages/core-blueprint-profiles-${locale}.po"
  staged_po="$PACKAGE_ROOT/languages/core-blueprint-profiles-${locale}.po"
  staged_mo="$PACKAGE_ROOT/languages/core-blueprint-profiles-${locale}.mo"
  [[ -s "$source_po" ]] || fail "reviewed PO is missing for $locale"
  cp "$source_po" "$staged_po"
  msgfmt --check-format --check-header -o "$staged_mo" "$staged_po"
  [[ -s "$staged_mo" ]] || fail "generated MO is missing for $locale"
done

POT="$PACKAGE_ROOT/languages/core-blueprint-profiles.pot"
[[ -s "$POT" ]] || fail "canonical POT is missing from release staging"

while IFS= read -r -d '' file; do
  php -l "$file" >/dev/null || fail "staged PHP lint failed: $file"
done < <(find "$PACKAGE_ROOT" -type f -name '*.php' -print0)

if [[ -d "$PACKAGE_ROOT/assets" ]]; then
  while IFS= read -r -d '' file; do
    node --check "$file" >/dev/null || fail "staged JavaScript syntax failed: $file"
  done < <(find "$PACKAGE_ROOT/assets" -type f -name '*.js' -print0)
fi

find "$PACKAGE_ROOT" -type f \( -name '.DS_Store' -o -name '*.map' -o -name '*.pyc' \) -delete
find "$PACKAGE_ROOT" -type d -name '__pycache__' -prune -exec rm -rf {} +
find "$PACKAGE_ROOT" -exec touch -t 198001010000 {} +
(
  cd "$STAGE"
  zip -X -q "$ZIP" "$SLUG/"
  find "$SLUG" -type f -print | LC_ALL=C sort | zip -X -q "$ZIP" -@
)

[[ -s "$ZIP" ]] || fail "release ZIP was not created"
unzip -tqq "$ZIP" || fail "release ZIP integrity check failed"
ZIP_ENTRIES="$(unzip -Z1 "$ZIP")"
FIRST_ENTRY="${ZIP_ENTRIES%%$'\n'*}"
[[ "$FIRST_ENTRY" == "$SLUG/" ]] || fail "release ZIP root is not $SLUG/"
if grep -Eq '(^|/)(\.git|\.github|tests|tools|docs|dist|build|node_modules|vendor)(/|$)' <<<"$ZIP_ENTRIES"; then
  fail "development-only files leaked into the release ZIP"
fi
for required in "$SLUG/core-blueprint-profiles.php" "$SLUG/README.md" "$SLUG/CHANGELOG.md" "$SLUG/uninstall.php" "$SLUG/languages/core-blueprint-profiles.pot"; do
  grep -Fxq "$required" <<<"$ZIP_ENTRIES" || fail "required release file missing from ZIP: $required"
done
for locale in "${LOCALES[@]}"; do
  for ext in po mo; do
    required="$SLUG/languages/core-blueprint-profiles-${locale}.${ext}"
    grep -Fxq "$required" <<<"$ZIP_ENTRIES" || fail "required catalog missing from ZIP: $required"
  done
done

PACKAGED_ENTRY="$PACKAGE_ROOT/core-blueprint-profiles.php"
[[ "$(header_value "$PACKAGED_ENTRY" 'Version')" == "$VERSION" ]] || fail "packaged Version header does not match source"
[[ "$(define_value "$PACKAGED_ENTRY" 'CB_PROFILES_VERSION')" == "$VERSION" ]] || fail "packaged version constant does not match source"
[[ "$(header_value "$PACKAGED_ENTRY" 'Requires Plugins')" == 'core-blueprint' ]] || fail "packaged native Base dependency is missing"

(
  cd "$DIST"
  sha256sum "$(basename "$ZIP")" > "$(basename "$CHECKSUM")"
)
[[ -s "$CHECKSUM" ]] || fail "release checksum was not created"
SHA256="$(awk '{print $1}' "$CHECKSUM")"
printf 'Profiles release build: PASS\nPackage: %s\nCanonical root: %s/\nSHA-256: %s\n' "$ZIP" "$SLUG" "$SHA256"
